# ============================================================
# SD-JWT API - Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

NODE_ENV=development
PORT=3006
LOG_LEVEL=info

# ---------- Issuer configuration ----------
# Issuer identifier - goes into `iss` and the credential `status` URL. Must be an absolute URL.
JWT_ISSUER=https://agristack.example.gov.in

# Key id placed in the JWS header
JWT_KEY_ID=jwt-signing-key-01

# ES256 (P-256) key files written by `npm run keys:generate`. Private key MUST NOT be committed.
JWT_PRIVATE_KEY_PATH=./src/keys/issuer-private.pem
JWT_PUBLIC_KEY_PATH=./src/keys/issuer-public.pem

# Alternatively supply the PEM inline (takes precedence over the path).
# JWT_PRIVATE_KEY=

# ---------- Limits ----------
# Max HTTP body size.
JSON_BODY_LIMIT=50mb

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---------- Hardening ----------
# Number of proxy hops to trust for the client IP. 0 = trust nothing, which is
# correct unless this service sits behind a load balancer you control.
TRUST_PROXY=0

# Hard ceiling on how long a single request may take to arrive (slowloris).
REQUEST_TIMEOUT_MS=20000
