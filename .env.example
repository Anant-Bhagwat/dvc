# ============================================================
# JWT API - Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------- JWT issuer configuration ----------
# Issuer identifier - MUST match the `iss` claim and be an absolute URL
JWT_ISSUER=https://agristack.example.gov.in

# Key id placed in the JWS header
JWT_KEY_ID=jwt-signing-key-01

# ES256 (P-256) key files. Private key MUST NOT be committed.
JWT_PRIVATE_KEY_PATH=./src/keys/issuer-private.pem
JWT_PUBLIC_KEY_PATH=./src/keys/issuer-public.pem

# Alternatively supply the PEM inline (takes precedence over the path).
# Useful for Docker/K8s secrets. Escape newlines as \n.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# `typ` written into the protected header and pinned on verification
JWT_TYP=JWT

# Default / maximum token lifetime in seconds
JWT_DEFAULT_EXPIRY=3600
JWT_MAX_EXPIRY=86400

# Allowed clock skew when validating exp/iat/nbf (seconds)
JWT_CLOCK_SKEW=60

# ---------- Verifier configuration ----------
# Comma-separated list of issuers accepted on /verify. Defaults to JWT_ISSUER.
JWT_TRUSTED_ISSUERS=https://agristack.example.gov.in

# Claim name the unrestricted `data` payload is nested under.
JWT_DATA_CLAIM=data

# Max HTTP body size. The `data` field has no schema, depth, key or value rules,
# so this is the ONLY ceiling on it.
JSON_BODY_LIMIT=50mb

# ---------- API auth (client -> this API) ----------
# Comma-separated static bearer tokens for service clients.
# Replace with your platform OAuth2 introspection in production.
API_ACCESS_TOKENS=replace-me-with-a-long-random-token
AUTH_ENABLED=true

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---------- Hardening ----------
# Number of proxy hops to trust for the client IP. 0 = trust nothing, which is
# correct unless this service sits behind a load balancer you control. Setting
# it too high lets a caller spoof X-Forwarded-For and evade the rate limiter.
TRUST_PROXY=0

# Failed-authentication budget per IP per window, on top of RATE_LIMIT_MAX.
# Only 401 responses count against it.
AUTH_RATE_LIMIT_MAX=10

# Hard ceiling on how long a single request may take to arrive (slowloris).
REQUEST_TIMEOUT_MS=20000
